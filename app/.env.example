# Copy to .env.local. Use your computer's LAN IP so a phone can reach the dev server.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
# Google Cloud Console > APIs & Services > Credentials (see README). These are public IDs, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
