{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.10:8787",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "",
        "EXPO_PUBLIC_PRIVACY_URL": "https://YOUR-SITE.example.com/privacy"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-SERVER.example.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "",
        "EXPO_PUBLIC_PRIVACY_URL": "https://YOUR-SITE.example.com/privacy",
        "EXPO_PUBLIC_TEST_BUILD": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-SERVER.example.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "REPLACE.apps.googleusercontent.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "",
        "EXPO_PUBLIC_PRIVACY_URL": "https://YOUR-SITE.example.com/privacy"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
