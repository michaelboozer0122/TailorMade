ANTHROPIC_API_KEY=sk-ant-...
PORT=8787

# Long random string that signs login sessions. Generate: openssl rand -base64 48
SESSION_SECRET=

# Sign-in: your iOS bundle ID (Apple) and your Google OAuth client IDs (Web + iOS), comma-separated.
APPLE_BUNDLE_IDS=com.tailormade.app
GOOGLE_CLIENT_IDS=

# Where the user/usage database lives. Put it on a persistent volume in production.
DB_PATH=./data/tailormade.db

# Per-user limits. Free is the default plan; promote users with: npm run set-plan -- <email> pro
FREE_TAILORS_PER_MONTH=10
FREE_PARSES_PER_DAY=5
PRO_TAILORS_PER_MONTH=200
PRO_PARSES_PER_DAY=20

# Per-IP backstop
RATE_LIMIT_PER_HOUR=60
# Set to 1 when running behind a load balancer/proxy (most hosts) so per-IP limits see real client IPs.
TRUST_PROXY=

# Local testing only: lets the app's dev build sign in with any email. Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=

# Subscriptions via RevenueCat (see README). Leave empty to disable.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT=pro
