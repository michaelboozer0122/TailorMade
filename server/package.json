{
  "name": "tailormade-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "set-plan": "node --env-file-if-exists=.env --import tsx src/admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
